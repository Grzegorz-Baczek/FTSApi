{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "postgres": {
      "type": "azure.bicep.v0",
      "connectionString": "{postgres.outputs.connectionString}",
      "path": "postgres.module.bicep"
    },
    "ftsdb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=ftsdb"
    },
    "storage": {
      "type": "azure.bicep.v0",
      "path": "storage.module.bicep"
    },
    "blobs": {
      "type": "value.v0",
      "connectionString": "{storage.outputs.blobEndpoint}"
    },
    "fts-api": {
      "type": "project.v0",
      "path": "../FTS.Api/FTS.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{fts-api.bindings.http.targetPort}",
        "ConnectionStrings__ftsdb": "{ftsdb.connectionString}",
        "FTSDB_HOST": "{postgres.outputs.hostName}",
        "FTSDB_PORT": "5432",
        "FTSDB_URI": "postgresql://{postgres.outputs.hostName}/ftsdb",
        "FTSDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.outputs.hostName}/ftsdb?sslmode=require\u0026authenticationPluginClassName=com.azure.identity.extensions.jdbc.postgresql.AzurePostgresqlAuthenticationPlugin",
        "FTSDB_DATABASENAME": "ftsdb",
        "ConnectionStrings__blobs": "{blobs.connectionString}",
        "BLOBS_URI": "{storage.outputs.blobEndpoint}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "fts-app": {
      "type": "project.v0",
      "path": "../FTS.App/FTS.App.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{fts-app.bindings.http.targetPort}",
        "FTS_API_HTTP": "{fts-api.bindings.http.url}",
        "services__fts-api__http__0": "{fts-api.bindings.http.url}",
        "FTS_API_HTTPS": "{fts-api.bindings.https.url}",
        "services__fts-api__https__0": "{fts-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "postgres-roles": {
      "type": "azure.bicep.v0",
      "path": "postgres-roles.module.bicep",
      "params": {
        "postgres_outputs_name": "{postgres.outputs.name}",
        "principalType": "",
        "principalId": "",
        "principalName": ""
      }
    },
    "storage-roles": {
      "type": "azure.bicep.v0",
      "path": "storage-roles.module.bicep",
      "params": {
        "storage_outputs_name": "{storage.outputs.name}",
        "principalType": "",
        "principalId": ""
      }
    }
  }
}