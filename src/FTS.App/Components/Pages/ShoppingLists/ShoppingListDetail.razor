@page "/shopping-lists/{Id:guid}"
@rendermode InteractiveServer

<PageTitle>@(_list?.Name ?? "Lista zakupów")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_list is null)
    {
        <MudAlert Severity="Severity.Error">Nie znaleziono listy zakupów.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Wróć
            </MudButton>
        </MudStack>

        <MudText Typo="Typo.h4" Class="mb-1" Style="font-family: 'Georgia', serif; font-weight: 700;">
            @_list.Name
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Dark" Class="mb-4">
            @_list.Items.Count(i => i.IsChecked) / @_list.Items.Count kupione
        </MudText>

        <MudProgressLinear Value="@GetProgress()" Color="Color.Success" Rounded="true" Size="Size.Medium" Class="mb-4" />

        @* ======== Dodawanie ręczne ======== *@
        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: 600;">Dodaj produkt</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_newItemName" Label="Nazwa produktu" Variant="Variant.Outlined" Style="flex: 2;" />
                <MudNumericField @bind-Value="_newItemQuantity" Label="Ilość" Variant="Variant.Outlined" Style="flex: 1;" />
                <MudTextField @bind-Value="_newItemUnit" Label="Jedn." Variant="Variant.Outlined" Style="flex: 0.7;" />
                <MudSelect @bind-Value="_newItemCategory" Label="Kategoria" Variant="Variant.Outlined" Style="flex: 1;">
                    <MudSelectItem Value="@((string?)null)">—</MudSelectItem>
                    <MudSelectItem Value="@("Nabiał")">Nabiał</MudSelectItem>
                    <MudSelectItem Value="@("Warzywa")">Warzywa</MudSelectItem>
                    <MudSelectItem Value="@("Owoce")">Owoce</MudSelectItem>
                    <MudSelectItem Value="@("Mięso")">Mięso</MudSelectItem>
                    <MudSelectItem Value="@("Pieczywo")">Pieczywo</MudSelectItem>
                    <MudSelectItem Value="@("Napoje")">Napoje</MudSelectItem>
                    <MudSelectItem Value="@("Chemia")">Chemia</MudSelectItem>
                    <MudSelectItem Value="@("Inne")">Inne</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="AddItem"
                           Disabled="string.IsNullOrWhiteSpace(_newItemName)">
                    Dodaj
                </MudButton>
            </MudStack>
        </MudPaper>

        @* ======== Skan paragonu / zdjęcia ======== *@
        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Class="mr-1" /> Dodaj produkty ze zdjęcia
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Dark" Class="mb-2">
                Zrób zdjęcie paragonu, listy zakupów lub notatki — AI rozpozna produkty.
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <InputFile OnChange="OnFileSelected" accept="image/*" class="mud-input-control" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ImageSearch"
                           OnClick="UploadImage"
                           Disabled="@(_selectedFile is null || _uploading)">
                    @if (_uploading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @:Analizuję...
                    }
                    else
                    {
                        @:Rozpoznaj produkty
                    }
                </MudButton>
            </MudStack>
            @if (_uploadError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_uploadError</MudAlert>
            }
        </MudPaper>

        @* ======== Lista produktów ======== *@
        @if (_list.Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                Lista jest pusta. Dodaj produkty ręcznie lub zeskanuj zdjęcie.
            </MudAlert>
        }
        else
        {
            @* Grupowanie po kategorii *@
            var grouped = _list.Items
                .GroupBy(i => i.Category ?? "Inne")
                .OrderBy(g => g.Key);

            @foreach (var group in grouped)
            {
                <MudText Typo="Typo.overline" Class="mt-3 ml-1" Style="font-weight: 600;">@group.Key</MudText>

                @foreach (var item in group.OrderBy(i => i.IsChecked))
                {
                    <MudPaper Elevation="1" Class="pa-2 mb-1" Style="border-radius: 8px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudCheckBox Value="@item.IsChecked"
                                             ValueChanged="@((bool _) => ToggleItem(item.Id))"
                                             Color="Color.Success" />
                                <MudText Style="@(item.IsChecked ? "text-decoration: line-through; color: grey;" : "")">
                                    @item.ProductName
                                </MudText>
                                @if (item.Quantity.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                        @item.Quantity @item.Unit
                                    </MudChip>
                                }
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="() => RemoveItem(item.Id)" />
                        </MudStack>
                    </MudPaper>
                }
            }
        }
    }

</MudContainer>
